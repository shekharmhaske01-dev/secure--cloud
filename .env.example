# ---------------------------------------------------------------------------
# SecureCloud environment template
# Copy to `.env` and fill in real values.  NEVER commit the filled-in .env.
# No real secret values appear in this file or anywhere in the repository.
# ---------------------------------------------------------------------------

# --- Flask application -----------------------------------------------------
FLASK_CONFIG=development
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_GENERATED_BY_scripts/generate_encryption_key.py --secret
SECURECLOUD_ENV=development

# --- Metadata database (SQLite) -------------------------------------------
# Absolute or relative path to the SQLite file that holds users, file
# metadata, wrapped keys and operation records.  Plaintext file content and
# unwrapped keys are NEVER stored here.
DATABASE_URL=sqlite:///securecloud.db

# --- Key-encryption key (KEK) ---------------------------------------------
# Master key used ONLY to wrap/unwrap per-file data-encryption keys.
# Generate it with:  python scripts/generate_encryption_key.py
# It is base64 for exactly 32 random bytes (AES-256).
# This value must live outside the database and outside object storage
# (environment variable / secret manager).  There is NO default and it is
# NEVER generated automatically at startup.
SECURECLOUD_KEY_ENCRYPTION_KEY=

# Refuse to boot if the key is missing or invalid (recommended everywhere).
SECURECLOUD_REQUIRE_KEY_AT_STARTUP=true
# Set to true only to open the UI for configuration inspection without a key.
# Crypto endpoints stay disabled in that mode.
SECURECLOUD_ALLOW_START_WITHOUT_KEY=false

# --- File handling --------------------------------------------------------
SECURECLOUD_BLOCK_SIZE=1048576
SECURECLOUD_MAX_UPLOAD_BYTES=268435456
SECURECLOUD_STAGING_DIR=staging

# --- Sessions -------------------------------------------------------------
SECURECLOUD_SESSION_HOURS=12
SECURECLOUD_SESSION_COOKIE_SECURE=false

# --- Object storage -------------------------------------------------------
# 'local' = development-only filesystem adapter (clearly reported as local).
# 's3'    = S3-compatible object storage (Neon Object Storage).
# 'hdfs'  = Hadoop Distributed File System (WebHDFS REST API).
# There is NO silent fallback: with 's3' or 'hdfs' the app fails loudly when
# settings are missing or the provider is unreachable.
SECURECLOUD_STORAGE_BACKEND=local
SECURECLOUD_OBJECT_PREFIX=securecloud/blocks
SECURECLOUD_STORAGE_TIMEOUT=30
SECURECLOUD_LOCAL_STORAGE_DIR=staging/local_object_storage

# --- S3-compatible object storage (Neon Object Storage) -------------------
# Neon Object Storage is S3-compatible and REQUIRES path-style addressing
# (boto3 addresing_style=path).  The endpoint is branch-scoped: read it from
# the Neon console / `neon env pull`.  Do NOT use a Neon PostgreSQL
# connection string here, and do NOT invent a host name - this is a
# placeholder only.
NEON_STORAGE_ENDPOINT_URL=REPLACE_WITH_YOUR_BRANCH_S3_ENDPOINT_URL
NEON_STORAGE_REGION=REPLACE_WITH_YOUR_BRANCH_REGION
NEON_STORAGE_BUCKET=REPLACE_WITH_YOUR_BUCKET_NAME
NEON_STORAGE_ACCESS_KEY_ID=REPLACE_WITH_YOUR_ACCESS_KEY_ID
NEON_STORAGE_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_SECRET_ACCESS_KEY

# Compatibility aliases: if the standard AWS variable names are present they
# are used when the NEON_STORAGE_* equivalent is not set.
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- HDFS distributed storage --------------------------------------------
# Set SECURECLOUD_STORAGE_BACKEND=hdfs and configure these values.
# The WebHDFS endpoint is the NameNode HTTP address (usually port 9870).
HDFS_NAMENODE_URL=http://localhost:9870
HDFS_USER=root
HDFS_ROOT_PATH=/securecloud

# --- Rate limiting --------------------------------------------------------
RATELIMIT_STORAGE_URI=memory://

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
